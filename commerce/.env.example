# ============================================================
# WhatsApp AI Commerce Agent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# ── LLM Provider ──────────────────────────────────────────────
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
MODEL_TEMPERATURE=0.2

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://commerce:commerce_secret@localhost:5432/commerce

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────
# Set provider to "mock" for development, "cloud_api" for production
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_VERIFY_TOKEN=commerce-verify-token
WHATSAPP_API_VERSION=v18.0

# ── Stripe (Payments) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ── FedEx ─────────────────────────────────────────────────────
FEDEX_API_KEY=your-fedex-api-key
FEDEX_SECRET_KEY=your-fedex-secret-key
FEDEX_ACCOUNT_NUMBER=your-fedex-account
FEDEX_METER_NUMBER=your-fedex-meter
FEDEX_TEST_MODE=true

# ── UPS ───────────────────────────────────────────────────────
UPS_API_KEY=your-ups-api-key
UPS_USERNAME=your-ups-username
UPS_PASSWORD=your-ups-password
UPS_TEST_MODE=true

# ── Shipping ──────────────────────────────────────────────────
DEFAULT_SHIPPING_PROVIDER=fedex

# ── File Storage (MinIO/S3) ──────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=commerce

# ── Application ───────────────────────────────────────────────
COMMERCE_PORT=8080
SECRET_KEY=change-this-to-a-random-secret-in-production
KNOWLEDGE_BASE_PATH=

# ── Dutchkem Model 4.0 (existing) ─────────────────────────────
MODEL_PROVIDER=openrouter
MULTI_PROVIDER_FALLBACK=true
