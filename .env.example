# Dutchkem Model 4.0 configuration
# Copy to .env and fill in your values.
# NOTE: shell/environment variables always take priority over values in this file.

# --- LLM provider (OpenAI-compatible endpoint) ---
# Any OpenAI-compatible API works: OpenAI, OpenRouter, vLLM, LM Studio, Groq, Together, etc.
# OPENAI_API_KEYS (comma-separated) is optional: keys rotate round-robin and
# fail over on 401/403/429/5xx. Falls back to OPENAI_API_KEY when unset.
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_KEYS=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Optional: Anthropic provider (used when MODEL_PROVIDER=anthropic or no OpenAI key) ---
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEYS=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet

# --- Free / open model providers (all OpenAI-compatible, all optional) ---
# Each supports X_API_KEY (single) and X_API_KEYS (pool, comma-separated) plus
# X_BASE_URL / X_MODEL overrides. Keys auto-rotate and fail over across 401/403/429/5xx.

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEYS=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat   (deepseek-reasoner for R1)

# Qwen / Alibaba DashScope — https://bailian.console.aliyun.com  (free quota per model)
DASHSCOPE_API_KEY=
DASHSCOPE_API_KEYS=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus          (qwen-max, qwen-turbo, qwen-coder-plus, qwen3-32b)

# Groq — https://console.groq.com  (free fast inference)
GROQ_API_KEY=
GROQ_API_KEYS=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — https://openrouter.ai  (free models use the ':free' suffix)
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Mistral — https://console.mistral.ai  (free experiment tier)
MISTRAL_API_KEY=
MISTRAL_API_KEYS=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_MODEL=open-mistral-nemo

# GitHub Models — free with a GitHub account/token (PAT works as the key)
GITHUB_TOKEN=
GITHUB_TOKENS=
# GITHUB_BASE_URL=https://models.inference.ai.azure.com
# GITHUB_MODEL=gpt-4o-mini

# --- Provider selection: openai | anthropic | ollama | deepseek | qwen | groq |
#     openrouter | mistral | github. Auto-detected from whichever keys are set. ---
# Example using the openapis.online proxy with a key pool (comma-separated).
# Keys rotate round-robin and fail over on 401/403/429/5xx responses:
#   MODEL_PROVIDER=openai
#   OPENAI_API_KEYS=sk-key-1,sk-key-2,sk-key-3
#   OPENAI_BASE_URL=https://api.openapis.online/openai
#   OPENAI_MODEL=gpt-4o-mini
#   ANTHROPIC_API_KEYS=sk-other-1,sk-other-2
#   ANTHROPIC_BASE_URL=https://api.openapis.online/anthropic
#   ANTHROPIC_MODEL=claude-3-5-sonnet
#
# MULTI_PROVIDER_FALLBACK=true means the client tries every configured provider
# (selected first, then DeepSeek -> Qwen -> Groq -> OpenRouter -> Mistral ->
# GitHub -> Anthropic) before falling back to Ollama, then offline mode.
MODEL_PROVIDER=
MULTI_PROVIDER_FALLBACK=true

# --- Local open-source fallback (Ollama, MIT) ---
# When cloud providers fail (or no key is set), the client automatically falls
# back to a local Ollama server. Install from ollama.com, then:
#   ollama pull qwen3-coder
# Best open coding model per 2026 benchmarks: qwen3-coder (Apache-2.0, 256K ctx).
# Alternatives: devstral:24b (agentic, SWE-bench 46.8%), qwen2.5-coder:14b.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-coder
OLLAMA_AUTO_FALLBACK=true

# Optional: default temperature for agents
MODEL_TEMPERATURE=0.2

# Global budget (seconds) for key rotation/retries across all providers
MAX_ATTEMPT_SECONDS=30

# --- Web UI ---
WEB_HOST=0.0.0.0
WEB_PORT=5000

# --- Persistent memory ---
MEMORY_PATH=./data/memory
KNOWLEDGE_PATH=./data/knowledge

# --- Sandbox ---
SANDBOX_TIMEOUT=60
SANDBOX_ALLOW_NETWORK=false

# --- Self-improvement ---
EVOLUTION_LOG_PATH=./data/evolution.log
